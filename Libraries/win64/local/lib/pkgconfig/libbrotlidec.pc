prefix=D:/a/telegram-prebuilt-libs/telegram-prebuilt-libs/Libraries/win64/local
exec_prefix=D:/a/telegram-prebuilt-libs/telegram-prebuilt-libs/Libraries/win64/local
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libbrotlidec
URL: https://github.com/google/brotli
Description: Brotli decoder library
Version: 1.0.9
Libs: -L${libdir} -lbrotlidec
Requires.private: libbrotlicommon >= 1.0.2
Cflags: -I${includedir}
