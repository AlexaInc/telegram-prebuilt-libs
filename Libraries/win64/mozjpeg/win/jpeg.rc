        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The mozjpeg Project"
            VALUE "FileDescription", "libjpeg API DLL"
            VALUE "FileVersion", "8,2,2,0"
            VALUE "ProductVersion", "4.1.5"
            VALUE "ProductName", "mozjpeg"
            VALUE "InternalName", "jpeg8"
            VALUE "LegalCopyright", L"Copyright \xA9 1991-2023 The libjpeg-turbo Project and many others"
            VALUE "OriginalFilename", "jpeg8.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
