#include "Winver.h"
#include "winres.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 8,2,2,0
 PRODUCTVERSION 4,001,005,0
 FILEFLAGSMASK 0x17L
#ifndef NDEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
