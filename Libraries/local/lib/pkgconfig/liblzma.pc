prefix=/workspaces/telegram-prebuilt-libs/Libraries/local
exec_prefix=/workspaces/telegram-prebuilt-libs/Libraries/local
libdir=/workspaces/telegram-prebuilt-libs/Libraries/local/lib
includedir=/workspaces/telegram-prebuilt-libs/Libraries/local/include

Name: liblzma
Description: General purpose data compression library
URL: https://tukaani.org/xz/
Version: 5.4.5
Cflags: -I${includedir}
Cflags.private: -DLZMA_API_STATIC
Libs: -L${libdir} -llzma
Libs.private:  
